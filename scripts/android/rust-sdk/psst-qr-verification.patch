 #[matrix_sdk_ffi_macros::export]
 impl SessionVerificationController {
+    /// PSST: set the listener for QR code verification progress.
+    pub fn set_qr_delegate(&self, delegate: Option<Box<dyn QrVerificationDelegate>>) {
+        *self.qr_delegate.write().unwrap() = delegate.map(Arc::from);
+    }
+
+    /// PSST: QR code roles possible with the other device (both false before the request is ready, or when the other
+    /// device only supports emoji, e.g. Element X iOS).
+    pub fn qr_options(&self) -> QrVerificationOptions {
+        let request = self.verification_request.read().unwrap().clone();
+        let theirs = request.and_then(|r| r.their_supported_methods()).unwrap_or_default();
+        let reciprocate = theirs.contains(&VerificationMethod::ReciprocateV1);
+        QrVerificationOptions {
+            can_show_qr_code: reciprocate && theirs.contains(&VerificationMethod::QrCodeScanV1),
+            can_scan_qr_code: reciprocate && theirs.contains(&VerificationMethod::QrCodeShowV1),
+        }
+    }
+
+    /// PSST: the QR code to show to the other device (binary Matrix verification QR data, to be encoded in byte
+    /// mode), or `None` when not possible. The emoji comparison stays possible afterwards.
+    pub async fn generate_qr_code(&self) -> Result<Option<Vec<u8>>, ClientError> {
+        let Some(request) = self.verification_request.read().unwrap().clone() else {
+            return Ok(None);
+        };
+        let Some(qr) = request.generate_qr_code().await? else {
+            return Ok(None);
+        };
+        let bytes = qr.to_bytes().map_err(ClientError::from_err)?;
+        self.track_qr_verification(qr);
+        Ok(Some(bytes))
+    }
+
+    /// PSST: the other device's QR code was scanned with the camera.
+    pub async fn scan_qr_code(&self, data: Vec<u8>) -> Result<QrScanResult, ClientError> {
+        let Some(request) = self.verification_request.read().unwrap().clone() else {
+            return Ok(QrScanResult::NotApplicable);
+        };
+        let Ok(data) = QrVerificationData::from_bytes(data) else {
+            return Ok(QrScanResult::InvalidCode);
+        };
+        match request.scan_qr_code(data).await {
+            Ok(Some(qr)) => {
+                self.track_qr_verification(qr);
+                Ok(QrScanResult::Started)
+            }
+            Ok(None) => Ok(QrScanResult::NotApplicable),
+            Err(matrix_sdk::Error::QrCodeScanError(e)) => {
+                warn!("Scanned verification QR code rejected: {e}");
+                Ok(QrScanResult::KeyMismatch)
+            }
+            Err(e) => Err(e.into()),
+        }
+    }
+
+    /// PSST: the user confirmed that the other device shows a successful scan of our code.
+    pub async fn confirm_qr_scanned(&self) -> Result<(), ClientError> {
+        let qr = self.qr_verification.read().unwrap().clone();
+        let Some(qr) = qr else {
+            return Err(ClientError::from_str("QR verification missing", None));
+        };
+        Ok(qr.confirm().await?)
+    }
