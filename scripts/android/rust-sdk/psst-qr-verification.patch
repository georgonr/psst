+                    );
+                    *cancel_info.write().unwrap() = Some(info.clone());
+                    report(QrVerificationProgress::Cancelled { cancel_info: info });
+                    if let Some(d) = Self::current_delegate(&delegate) {
+                        d.did_cancel();
+                    }
+                    break;
+                }
