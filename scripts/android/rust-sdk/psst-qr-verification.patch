+    async fn listen_to_qr_verification_changes(
+        qr: QrVerification,
+        delegate: Delegate,
+        qr_delegate: QrDelegate,
+        cancel_info: Arc<RwLock<Option<SessionVerificationCancelInfo>>>,
+    ) {
+        let report = |progress: QrVerificationProgress| {
