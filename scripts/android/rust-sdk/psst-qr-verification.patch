+                SdkQrVerificationState::Confirmed => report(QrVerificationProgress::Confirmed),
+                SdkQrVerificationState::Reciprocated => report(QrVerificationProgress::Reciprocated),
+                SdkQrVerificationState::Done { .. } => {
