+/// PSST: methods advertised in requests and ready events: emoji (SAS) and both QR code roles, as Element Web.
+fn psst_verification_methods() -> Vec<VerificationMethod> {
+    vec![
+        VerificationMethod::SasV1,
+        VerificationMethod::QrCodeScanV1,
+        VerificationMethod::QrCodeShowV1,
+        VerificationMethod::ReciprocateV1,
+    ]
+}
+
+/// PSST: which QR code roles are possible with the other device of the current request.
+#[derive(uniffi::Record)]
+pub struct QrVerificationOptions {
+    /// The other device can scan, so this device can show a QR code.
+    pub can_show_qr_code: bool,
+    /// The other device can show a QR code, so this device can scan it.
+    pub can_scan_qr_code: bool,
+}
+
+/// PSST: result of [`SessionVerificationController::scan_qr_code`].
+#[derive(uniffi::Enum)]
+pub enum QrScanResult {
+    /// The code belongs to this verification; the other device must now confirm.
+    Started,
+    /// Not a Matrix verification QR code (or damaged).
+    InvalidCode,
+    /// A verification QR code, but for another flow, user or keys.
+    KeyMismatch,
+    /// No verification request ready for a QR code.
+    NotApplicable,
+}
+
+/// PSST: progress of a QR code verification.
+#[derive(uniffi::Enum)]
+pub enum QrVerificationProgress {
+    /// The other device scanned the code shown here: ask the user whether it shows a confirmation.
+    Scanned,
+    /// This device scanned the other one's code: the other device must confirm.
+    Reciprocated,
+    /// We confirmed the other side's scan, waiting for it to finish.
+    Confirmed,
+    /// Verified; [`SessionVerificationControllerDelegate::did_finish`] is called too.
+    Done,
+    /// Cancelled; [`SessionVerificationControllerDelegate::did_cancel`] is called too.
+    Cancelled { cancel_info: SessionVerificationCancelInfo },
+}
+
+/// PSST: listener for QR code verification progress.
+#[matrix_sdk_ffi_macros::export(callback_interface)]
+pub trait QrVerificationDelegate: SyncOutsideWasm + SendOutsideWasm {
+    fn did_change_qr_progress(&self, progress: QrVerificationProgress);
+}
+
+pub type QrDelegate = Arc<RwLock<Option<Arc<dyn QrVerificationDelegate>>>>;
+
