# PSST: the matrix-rust-sdk build used by psst Android (docs/android-search.md).
# Must match libs.versions.toml `matrix_sdk` in forks/android and the commit that release was built from
# (https://github.com/matrix-org/matrix-rust-components-kotlin/releases/tag/sdk-v<SDK_VERSION>).
SDK_VERSION=26.11.05
RUST_SDK_REF=3ff03638028fd9abf58203153722b94b4293a87a
# Bump when a *.patch changes; the release tag is android-rust-sdk-<SDK_VERSION>-psst<PSST_REV>.
PSST_REV=2
