+/// PSST: name of the tokenizer used for message bodies: the tantivy default
+/// (split on non-alphanumerics, drop tokens over 40 bytes, lowercase) plus
+/// ASCII folding, so `cislo` finds `číslo` and `stastny` finds `šťastný`.
+/// The same analyzer runs on the query, so diacritics are ignored both ways.
+pub(crate) const BODY_TOKENIZER: &str = "psst_folded";
+
+/// PSST: the analyzer registered as [`BODY_TOKENIZER`] on every index.
+pub(crate) fn body_analyzer() -> TextAnalyzer {
+    TextAnalyzer::builder(SimpleTokenizer::default())
+        .filter(RemoveLongFilter::limit(40))
+        .filter(LowerCaser)
+        .filter(AsciiFoldingFilter)
+        .build()
+}
