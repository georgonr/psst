+    /// PSST: diacritics and case are ignored both ways, and a word prefix
+    /// matches the whole word.
+    #[test]
+    fn test_search_folds_diacritics_and_matches_prefixes() -> Result<(), Box<dyn Error>> {
+        let room_id = room_id!("!room_id:localhost");
+        let mut index = RoomIndexBuilder::new_in_memory(room_id).build();
+        let f = EventFactory::new().room(room_id).sender(user_id!("@user_id:localhost"));
+
+        let cislo = event_id!("$cislo:localhost");
+        let stastny = event_id!("$stastny:localhost");
+        let plain = event_id!("$plain:localhost");
+        for (id, body) in [
+            (cislo, "Moje telefónne Číslo je 0905"),
+            (stastny, "Šťastný nový rok, ľúbim ťa"),
+            (plain, "cislo bez diakritiky"),
+        ] {
+            index_message(
+                &mut index,
+                f.text_msg(body).event_id(id).into_any_sync_message_like_event(),
+            )?;
+        }
+
+        let ids = |query: &str| -> HashSet<_> {
+            index
+                .search(query, 10, None)
+                .unwrap_or_else(|err| panic!("search {query} failed: {err}"))
+                .events
+                .into_iter()
+                .map(|(_, id)| id)
+                .collect()
+        };
+        let set = |ids: &[&EventId]| -> HashSet<_> { ids.iter().map(|id| (*id).to_owned()).collect() };
+
+        assert_eq!(ids("cislo"), set(&[cislo, plain]));
+        assert_eq!(ids("číslo"), set(&[cislo, plain]));
+        assert_eq!(ids("CISLO"), set(&[cislo, plain]));
+        assert_eq!(ids("stastny"), set(&[stastny]));
+        assert_eq!(ids("Šťast"), set(&[stastny]));
+        assert_eq!(ids("cis"), set(&[cislo, plain]));
+        assert_eq!(ids("lubim"), set(&[stastny]));
+        assert_eq!(ids("+tel +cis"), set(&[cislo]));
+        assert_eq!(ids("+diakritiky +moje"), set(&[]));
+        assert_eq!(ids("telefon"), set(&[cislo]));
+        assert_eq!(ids("rokx"), set(&[]));
+
+        Ok(())
+    }
+
