# PSST server — vzor konfigurácie.
# ./deploy.sh pri prvom spustení vytvorí server/.env automaticky (s náhodnými tajomstvami).
# Tento súbor slúži len ako dokumentácia a na `docker compose config` validáciu v CI.
# NIKDY necommitujte skutočný server/.env.

# --- domény (server_name sa po prvom spustení NESMIE meniť) — D85 ---
# Matrix server_name (ID @meno:psst.pro); homeserver je na MATRIX_DOMAIN (delegácia cez .well-known na psst.pro)
SERVER_NAME=psst.pro
MATRIX_DOMAIN=chat.psst.pro
APP_DOMAIN=app.psst.pro
CALL_DOMAIN=call.psst.pro
# MAS na ceste https://chat.psst.pro/auth/ (D42); samostatná subdoména: AUTH_DOMAIN=auth.psst.pro a AUTH_PREFIX=
AUTH_DOMAIN=chat.psst.pro
AUTH_PREFIX=/auth
# TURN/TLS zdieľa :443 s call.psst.pro (rozlíšenie podľa ALPN, D42)
TURN_DOMAIN=call.psst.pro
SERVER_IP=203.0.113.10

# --- Let's Encrypt ---
LETSENCRYPT_EMAIL=admin@psst.pro
# 1 = vyžiadať certifikáty z LE staging (na skúšku, bez rate-limitov)

# --- LiveKit ---
# true = verejná IP sa zistí cez STUN (bežný VPS). false = použije sa LIVEKIT_NODE_IP alebo lokálne IP.
LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_NODE_IP=
LIVEKIT_API_KEY=psst_changeme
LIVEKIT_API_SECRET=changeme_changeme_changeme_changeme_changeme

# --- tajomstvá (generuje deploy.sh) ---
POSTGRES_PASSWORD=changeme
SYNAPSE_MACAROON_SECRET_KEY=changeme
SYNAPSE_FORM_SECRET=changeme
LK_JWT_AS_TOKEN=changeme
LK_JWT_HS_TOKEN=changeme

# Android App Links: SHA-256 odtlačok release certifikátu (verejný)
ANDROID_CERT_SHA256=3A:64:28:CF:51:EE:8F:5E:10:E8:4F:AC:5C:A8:A6:B3:C3:B8:C3:4D:26:74:DB:0F:22:24:D1:D0:09:7D:38:99
# iOS Universal Links: Apple Developer Team ID (doplniť)
APPLE_TEAM_ID=
TURN_SECRET=change-me
COMPOSE_FILE=compose.yml
COMPOSE_PROFILES=
# úvodná stránka (D82) + .well-known/matrix na server_name; www. len presmeruje (D85) — v spoločnom certifikáte
WEB_DOMAIN=psst.pro
WWW_DOMAIN=www.psst.pro
